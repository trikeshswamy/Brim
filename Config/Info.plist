<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- In-app updates (Sparkle). The feed is the appcast attached to the public repo's latest release. -->
	<key>SUFeedURL</key>
	<string>https://github.com/trikeshswamy/Brim/releases/latest/download/appcast.xml</string>
	<!-- Public half of the update-signing key; the private half lives only in the keychain of the Mac that releases. -->
	<key>SUPublicEDKey</key>
	<string>LtiU+0KJpEibATrKRq/VE0wxG0aVeTE649aukoyKn6U=</string>
	<!-- Checks once a day without asking first; installing always asks. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUAutomaticallyUpdate</key>
	<false/>
</dict>
</plist>
